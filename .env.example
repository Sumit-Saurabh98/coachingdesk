DATABASE_URL=postgres://coachingdesk:coachingdesk@localhost:5432/coachingdesk
REDIS_URL=redis://localhost:6379

# API
PORT=3000
TRUST_PROXY=false
# Dev-only value. Production gets a random 64-char secret from Secrets Manager.
JWT_SECRET=dev-only-jwt-secret-change-me-abcdefghijklmnopqrstuv
OTP_HASH_SECRET=dev-only-otp-hash-secret-change-me-0123456789
# console = print OTPs in the API log (local dev only; refused in production)
SMS_PROVIDER=console
OTP_DAILY_BUDGET=2000
# Store-review login (fixed OTP, no SMS). Leave empty locally.
REVIEW_LOGIN_PHONE=
REVIEW_LOGIN_OTP=

# Worker (pnpm --filter @coachingdesk/api worker)
# console = print messages locally; meta = WhatsApp Cloud API (not implemented yet)
WHATSAPP_PROVIDER=console
OUTBOX_POLL_MS=5000
INVOICE_POLL_MS=900000
