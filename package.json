{
  "name": "coachingdesk",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @coachingdesk/db generate",
    "db:migrate": "pnpm --filter @coachingdesk/db migrate",
    "db:studio": "pnpm --filter @coachingdesk/db studio",
    "db:seed": "pnpm --filter @coachingdesk/api seed"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "prettier": "^3.9.10",
    "turbo": "^2.11.9",
    "typescript": "~6.0.3"
  }
}
